{
  "name": "@12luckydev/utils",
  "version": "3.1.1",
  "description": "Utils for working with arrays!",
  "keywords": [
    "array",
    "add",
    "edit",
    "delete"
  ],
  "source": "src/index.ts",
  "sideEffects": false,
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "engines": {
    "node": ">=14"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "vitest",
    "build": "npm-run-all build:*",
    "build:clean": "rimraf lib",
    "build:tsup": "tsup",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint .",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "test": "vitest run",
    "e2e": "npm-run-all e2e:*",
    "e2e:pack": "npm pack --pack-destination e2e",
    "e2e:rename": "node e2e/npm-pack-rename.js"
  },
  "author": "12luckydev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12LuckyDev/utils.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/eslint__js": "^8.42.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vitest": "^4.0.18"
  }
}
